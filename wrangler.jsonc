{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yazi-ae",
  "main": "./src/index.js",
  "compatibility_date": "2026-08-11",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yazi-db",
      "database_id": "PASTE_D1_DATABASE_ID_HERE",
      "migrations_dir": "migrations"
    }
  ]
}
