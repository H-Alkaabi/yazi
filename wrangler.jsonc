{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yazi",
  "main": "./src/index.js",
  "compatibility_date": "2026-08-11",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },

  "vars": {
    "NOTIFY_EMAIL": "hello@yazi.ae",
    "EMAIL_FROM": "YAZI Models <models@notify.yazi.ae>"
  },

"vars": {
  "NOTIFY_EMAIL": "hello@yazi.ae",
  "EMAIL_FROM": "YAZI Models <models@notify.yazi.ae>",

  "WHATSAPP_PHONE_NUMBER_ID": "سنأخذه من Meta",
  "WHATSAPP_NOTIFY_TO": "971509149431",
  "WHATSAPP_TEMPLATE_NAME": "new_model_application",
  "WHATSAPP_TEMPLATE_LANG": "ar"
},

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yazi-db",
      "database_id": "5df9414f-58e1-4db4-9092-701b3e1ff8d2",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "MODEL_UPLOADS",
      "bucket_name": "yazi-model-uploads"
    }
  ]
}
